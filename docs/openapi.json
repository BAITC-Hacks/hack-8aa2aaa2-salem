{
  "openapi": "3.1.0",
  "info": {
    "title": "ЭКТ Каталог API прототипа",
    "version": "1.4.0",
    "description": "Каталог ekt.kz и агент подбора комплектов. Явный выбор готового варианта автоматически добавляет его в тестовую корзину. Реальные заказы не создаются."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/session": {
      "post": {
        "summary": "Создать или восстановить сессию и получить начальное состояние",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cart": {
                      "$ref": "#/components/schemas/Cart"
                    },
                    "catalog": {
                      "$ref": "#/components/schemas/Catalog"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "agent",
                        "catalog"
                      ]
                    },
                    "conversationStatus": {
                      "type": "string",
                      "enum": [
                        "active",
                        "completed"
                      ]
                    }
                  },
                  "required": [
                    "cart",
                    "catalog",
                    "messages",
                    "conversationStatus"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {}
            }
          }
        },
        "security": []
      }
    },
    "/products": {
      "get": {
        "summary": "Получить загруженную выборку товаров",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Получить свежую карточку из API ekt.kz",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/products/{id}/alternatives": {
      "get": {
        "summary": "Кандидаты с совпадением заданных параметров; не гарантия взаимозаменяемости",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "items",
                    "message"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/catalog/load": {
      "post": {
        "summary": "Загрузить следующую страницу каталога",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {}
            }
          }
        }
      }
    },
    "/cart": {
      "get": {
        "summary": "Прочитать тестовую корзину текущей сессии",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/proposals": {
      "post": {
        "summary": "Подготовить предложение без изменения корзины",
        "responses": {
          "201": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proposal"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productId": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  }
                },
                "required": [
                  "productId",
                  "quantity"
                ]
              }
            }
          }
        }
      }
    },
    "/proposals/{id}/confirm": {
      "post": {
        "summary": "Подтвердить предложение; повторный вызов не дублирует добавление",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "applied"
                    },
                    "cart": {
                      "$ref": "#/components/schemas/Cart"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "status",
                    "cart"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "confirmed": {
                    "const": true
                  }
                },
                "required": [
                  "confirmed"
                ]
              }
            }
          }
        }
      }
    },
    "/cart/remove": {
      "post": {
        "summary": "Удалить позицию после явного подтверждения",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productId": {
                    "type": "string"
                  },
                  "confirmed": {
                    "const": true
                  }
                },
                "required": [
                  "productId",
                  "confirmed"
                ]
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Диалог, подбор полного решения и явный выбор варианта",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "agent",
                        "catalog",
                        "unavailable"
                      ]
                    },
                    "cartLink": {
                      "type": "string"
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "ok": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "suggestions": {
                      "type": "array",
                      "maxItems": 3,
                      "description": "Редактируемые черновики реплик клиента. Кнопка заполняет поле, никогда не отправляет сообщение. Старые сохранённые строковые подсказки поддерживаются интерфейсом.",
                      "items": {
                        "$ref": "#/components/schemas/ChatSuggestion"
                      }
                    },
                    "proposal": {
                      "$ref": "#/components/schemas/Proposal"
                    },
                    "comparison": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "checkedAt": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "solution": {
                      "$ref": "#/components/schemas/SolutionPlan"
                    },
                    "solutionReceipt": {
                      "$ref": "#/components/schemas/SolutionPlan"
                    },
                    "cart": {
                      "$ref": "#/components/schemas/Cart"
                    },
                    "replayed": {
                      "type": "boolean"
                    },
                    "conversationStatus": {
                      "type": "string",
                      "enum": [
                        "active",
                        "completed"
                      ]
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "needs_input",
                        "complete"
                      ]
                    }
                  },
                  "required": [
                    "text",
                    "mode"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "productId": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "description": "Завершённый разговор возвращает 409 CONVERSATION_COMPLETED; сначала POST /conversation/resume. Явное согласие с показанным предложением или выбор комплекта добавляет товары без второго подтверждения. Прямое указание позволяет изменить количество или удалить одну существующую позицию. outcome=complete завершает задачу; suggestions пустой. Изменения корзины возвращают авторитетную квитанцию и cart."
      }
    },
    "/solutions/{id}/select": {
      "post": {
        "summary": "Выбрать и атомарно добавить полный комплект",
        "description": "Повторный выбор того же варианта идемпотентен. Другой вариант уже применённого плана не добавляется. Сервер повторно проверяет все цены, характеристики и остатки с учётом корзины. При несовпадении ни одна позиция не добавляется.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "optionKey",
                  "confirmed"
                ],
                "properties": {
                  "optionKey": {
                    "enum": [
                      "budget",
                      "extended"
                    ]
                  },
                  "confirmed": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Комплект добавлен или повторный запрос",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "text",
                    "cart",
                    "solutionReceipt",
                    "replayed"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "cart": {
                      "$ref": "#/components/schemas/Cart"
                    },
                    "solutionReceipt": {
                      "$ref": "#/components/schemas/SolutionPlan"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Чужая сессия или подбор не существует"
          },
          "409": {
            "description": "Изменение данных, нехватка остатка или ранее выбран другой вариант"
          },
          "410": {
            "description": "Подбор истёк или заменён"
          },
          "422": {
            "description": "Нет явного выбора или неверный вариант"
          }
        }
      }
    },
    "/conversation/resume": {
      "post": {
        "summary": "Возобновить разговор с сохранением истории и корзины",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Состояние сохранено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversationStatus": {
                      "type": "string",
                      "enum": [
                        "active",
                        "completed"
                      ]
                    }
                  },
                  "required": [
                    "conversationStatus"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Предыдущий ответ ещё обрабатывается"
          }
        }
      }
    },
    "/conversation/complete": {
      "post": {
        "summary": "Завершить разговор без удаления данных",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Состояние сохранено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversationStatus": {
                      "type": "string",
                      "enum": [
                        "active",
                        "completed"
                      ]
                    }
                  },
                  "required": [
                    "conversationStatus"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Предыдущий ответ ещё обрабатывается"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ekt_session"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "manufacturerSku": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "conflict": {
            "type": "boolean"
          },
          "conflictText": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "label",
                "value"
              ]
            }
          },
          "stores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "name",
                "quantity"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "sku",
          "price",
          "conflict"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Cart": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "demo"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product": {
                  "$ref": "#/components/schemas/Product"
                },
                "quantity": {
                  "type": "integer"
                }
              },
              "required": [
                "product",
                "quantity"
              ]
            }
          },
          "total": {
            "type": "number"
          },
          "itemCount": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "mode",
          "items",
          "total",
          "itemCount",
          "url"
        ]
      },
      "Proposal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "quantity": {
            "type": "integer"
          },
          "total": {
            "type": "number"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "const": "pending"
          }
        },
        "required": [
          "id",
          "product",
          "quantity",
          "expiresAt"
        ]
      },
      "Catalog": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "pages": {
            "type": "integer"
          },
          "complete": {
            "type": "boolean"
          },
          "syncedAt": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "pages",
          "complete"
        ]
      },
      "Requirement": {
        "type": "object",
        "required": [
          "id",
          "label",
          "query",
          "quantity",
          "constraints"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "constraints": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "SolutionPlan": {
        "type": "object",
        "required": [
          "id",
          "goal",
          "requirements",
          "options",
          "report",
          "createdAt",
          "expiresAt",
          "status",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "goal": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "pending",
              "applied",
              "expired",
              "superseded"
            ]
          },
          "selectedKey": {
            "enum": [
              "budget",
              "extended"
            ]
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/Requirement"
            }
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "enum": [
                    "budget",
                    "extended"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "tradeoffs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "total": {
                  "type": "number"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "product": {
                        "$ref": "#/components/schemas/Product"
                      },
                      "quantity": {
                        "type": "integer"
                      },
                      "requirementId": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      },
                      "subtotal": {
                        "type": "number"
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "report": {
            "type": "object",
            "properties": {
              "assessment": {
                "type": "string"
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclusions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "nextSteps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ChatSuggestion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "text",
          "kind"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 64
          },
          "text": {
            "type": "string",
            "maxLength": 240
          },
          "kind": {
            "type": "string",
            "enum": [
              "fill",
              "reply"
            ],
            "description": "fill содержит [поле для заполнения], reply — полная реплика клиента без шаблонных полей."
          }
        }
      }
    }
  }
}
