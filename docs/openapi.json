{
  "openapi": "3.1.0",
  "info": {
    "title": "ЭКТ Каталог API прототипа",
    "version": "1.1.0",
    "description": "Каталог ekt.kz через сервер. ИИ-агент использует проверяемые инструменты и историю сессии. Корзина тестовая; её изменение требует отдельного подтверждения. Вложения пока не поддерживаются."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/session": {
      "post": {
        "summary": "Создать или восстановить сессию и получить начальное состояние",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cart": {
                      "$ref": "#/components/schemas/Cart"
                    },
                    "catalog": {
                      "$ref": "#/components/schemas/Catalog"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "mode": {
                      "const": "catalog"
                    }
                  },
                  "required": [
                    "cart",
                    "catalog",
                    "messages"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {}
            }
          }
        },
        "security": []
      }
    },
    "/products": {
      "get": {
        "summary": "Получить загруженную выборку товаров",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Получить свежую карточку из API ekt.kz",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/products/{id}/alternatives": {
      "get": {
        "summary": "Кандидаты с совпадением заданных параметров; не гарантия взаимозаменяемости",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "items",
                    "message"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/catalog/load": {
      "post": {
        "summary": "Загрузить следующую страницу каталога",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {}
            }
          }
        }
      }
    },
    "/cart": {
      "get": {
        "summary": "Прочитать тестовую корзину текущей сессии",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/proposals": {
      "post": {
        "summary": "Подготовить предложение без изменения корзины",
        "responses": {
          "201": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proposal"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productId": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  }
                },
                "required": [
                  "productId",
                  "quantity"
                ]
              }
            }
          }
        }
      }
    },
    "/proposals/{id}/confirm": {
      "post": {
        "summary": "Подтвердить предложение; повторный вызов не дублирует добавление",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "applied"
                    },
                    "cart": {
                      "$ref": "#/components/schemas/Cart"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "status",
                    "cart"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "confirmed": {
                    "const": true
                  }
                },
                "required": [
                  "confirmed"
                ]
              }
            }
          }
        }
      }
    },
    "/cart/remove": {
      "post": {
        "summary": "Удалить позицию после явного подтверждения",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productId": {
                    "type": "string"
                  },
                  "confirmed": {
                    "const": true
                  }
                },
                "required": [
                  "productId",
                  "confirmed"
                ]
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Детерминированный поиск и консультация по каталогу; не меняет корзину",
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "agent",
                        "catalog",
                        "unavailable"
                      ]
                    },
                    "cartLink": {
                      "type": "string"
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "ok": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "suggestions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "proposal": {
                      "$ref": "#/components/schemas/Proposal"
                    },
                    "comparison": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "checkedAt": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "text",
                    "mode"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Ошибка; код в error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "productId": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "description": "Агент сам выбирает инструменты; максимум 60 сообщений/час на сессию. Корзина не изменяется. Ответ может содержать предложение для отдельного подтверждения, карточки, сравнение и проверенные источники. 409 означает параллельный запрос; 429 — лимит сообщений."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ekt_session"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "manufacturerSku": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "conflict": {
            "type": "boolean"
          },
          "conflictText": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "label",
                "value"
              ]
            }
          },
          "stores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "name",
                "quantity"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "sku",
          "price",
          "conflict"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Cart": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "demo"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product": {
                  "$ref": "#/components/schemas/Product"
                },
                "quantity": {
                  "type": "integer"
                }
              },
              "required": [
                "product",
                "quantity"
              ]
            }
          },
          "total": {
            "type": "number"
          },
          "itemCount": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "mode",
          "items",
          "total",
          "itemCount",
          "url"
        ]
      },
      "Proposal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "quantity": {
            "type": "integer"
          },
          "total": {
            "type": "number"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "const": "pending"
          }
        },
        "required": [
          "id",
          "product",
          "quantity",
          "expiresAt"
        ]
      },
      "Catalog": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "pages": {
            "type": "integer"
          },
          "complete": {
            "type": "boolean"
          },
          "syncedAt": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "pages",
          "complete"
        ]
      }
    }
  }
}